[Unit]
Description=Antigravity Telegram Bot Assistant
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/telegram_bot
ExecStart=/usr/bin/python3 /root/telegram_bot/bot.py
Restart=always
RestartSec=5
StandardOutput=append:/root/telegram_bot/data/bot.log
StandardError=append:/root/telegram_bot/data/bot.log
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
