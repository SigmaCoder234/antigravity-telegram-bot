# =========================================================
# Antigravity Telegram Bot Configuration
# =========================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Allowed Telegram User IDs (comma-separated, e.g. 123456789,987654321)
# Leave empty to automatically authorize the first user who sends /start
ALLOWED_USER_IDS=

# 3. Default AI Model (e.g. gemini-3.7-flash-high, claude-sonnet-4-6, claude-opus-4-6-thinking)
DEFAULT_MODEL=gemini-3.7-flash-high

# 4. Reasoning Effort (low, medium, high)
DEFAULT_EFFORT=high

# 5. Default Workspace Directory
DEFAULT_CWD=/root

# 6. Default Mode ('auto' for full automation, 'review' for confirmations)
DEFAULT_MODE=auto

# 7. Path to agy binary (optional, automatically detected if omitted)
AGY_BIN_PATH=/root/.local/bin/agy
