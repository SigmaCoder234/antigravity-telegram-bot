# =========================================================
# Claude Code Telegram Bot Configuration
# =========================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Allowed Telegram User IDs (comma-separated, e.g. 123456789,987654321)
# Leave empty to automatically authorize the first user who sends /start
ALLOWED_USER_IDS=

# 3. Default model: alias (opus, sonnet, haiku, fable) or full id (claude-opus-5-5, ...)
DEFAULT_MODEL=opus

# 4. Reasoning effort (low, medium, high, xhigh, max)
DEFAULT_EFFORT=high

# 5. Default Workspace Directory
DEFAULT_CWD=/root

# 6. Default Mode ('auto' for full automation, 'review' for confirmations)
DEFAULT_MODE=auto

# 7. Path to the claude binary (optional, automatically detected if omitted)
# CLAUDE_BIN_PATH=/usr/local/bin/claude

# 8. Authentication for Claude Code (choose one):
#    a) run `claude` once interactively on the server and log in with your Claude subscription, or
#    b) set an API key:
# ANTHROPIC_API_KEY=sk-ant-...

# 9. Optional: fallback model when the primary one is overloaded
# FALLBACK_MODEL=sonnet

# 10. Optional: max spend per request in USD (API-key billing only)
# MAX_BUDGET_USD=2

# 11. Optional: extra raw arguments for every claude call
# CLAUDE_EXTRA_ARGS=--add-dir /srv/projects

# 12. Claude Code refuses to bypass permissions when running as root.
#     Prefer running the bot as a regular user. If you deliberately run it as
#     root on an isolated server, you can acknowledge that with:
# IS_SANDBOX=1

# 13. Send Claude's answers as native Telegram rich messages (Bot API 10.1+):
#     headings, tables, lists, code blocks and formulas. Set to false to use plain HTML.
RICH_MESSAGES=true
# Max characters per rich message before splitting (auto-reduced if Telegram rejects it)
# RICH_MAX_CHARS=16000

# 14. Stream the answer live as an animated rich-message draft (private chats only)
STREAM_RESPONSES=true
